{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'; base-uri 'self'; object-src 'none';" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/openclaw", "destination": "/openclaw.html" }
  ],
  "redirects": [
    { "source": "/openclaw/", "destination": "/openclaw", "permanent": true },
    { "source": "/aria.html", "destination": "/aria", "permanent": true },
    { "source": "/pricing", "destination": "/openclaw#offers", "permanent": true }
  ]
}
